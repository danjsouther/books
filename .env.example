# Copy to .env for local development. See packages/config/src/env.ts for the
# validated shape — the process fails fast at boot if any of this is wrong.
#
# For docker compose, this same file (or a copy) is loaded via `--env-file` —
# see the "Docker Compose" section at the bottom for the variables that adds.

NODE_ENV=development
PORT=4000
TZ=UTC
LOG_LEVEL=info

# The origin the browser loads the app from. In dev this is the Angular dev
# server, not the API — the proxy keeps both same-origin from the browser's side.
PUBLIC_BASE_URL=http://localhost:4200

DATABASE_URL=postgres://books:books@localhost:5432/books

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30

COOKIE_SECURE=true
# COOKIE_DOMAIN=

# From your Discord application's OAuth2 page. The redirect URI must match one
# registered there exactly, including the path — through the dev-server proxy
# that is the web app's own origin, not the API's.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4200/api/v1/auth/discord/callback

# The Discord guild (server) id that gates access. Members outside this guild
# authenticate successfully with Discord but are rejected at the callback.
DISCORD_ALLOWED_GUILD_ID=

# The bot's own token, from your Discord application's Bot page — separate
# from DISCORD_CLIENT_SECRET, which is for the web login flow.
DISCORD_BOT_TOKEN=
# Your Discord application's id (the "Application ID" on its General
# Information page, not the bot's user id).
DISCORD_APP_ID=
# Set for instant, guild-scoped slash-command registration during local dev.
# Leave unset for global registration (up to 1h to propagate).
# DISCORD_GUILD_ID=

# Where the bot sends a member to sign in, e.g. in the "you're not linked yet"
# reply. In dev this is the same origin as PUBLIC_BASE_URL, but they're kept
# as separate variables — see packages/config/src/env.ts.
WEB_BASE_URL=http://localhost:4200

# The channel `npm run bot:post-changelog` posts a release announcement to.
# Right-click the channel in Discord (Developer Mode on) and "Copy Channel ID".
DISCORD_CHANGELOG_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Docker Compose only — read by docker-compose.yml and docker/initdb/*.sh
# directly, not by packages/config/src/env.ts. Not needed for `npm run dev`.
# ---------------------------------------------------------------------------

# The Postgres superuser Compose creates the database with. This is also the
# "server: full" role DATABASE_URL uses for the server and migrate services.
POSTGRES_USER=books
POSTGRES_PASSWORD=
POSTGRES_DB=books

# A second, read-only Postgres role — created once by
# docker/initdb/01-books-bot-role.sh — that the bot service's DATABASE_URL
# uses instead of POSTGRES_USER/POSTGRES_PASSWORD. The bot only ever SELECTs;
# this is what makes that true at the database level too, not just in the
# application code.
BOOKS_BOT_PASSWORD=

# Which HOST port maps to the server container's own port 4000. The
# container always listens on 4000 internally regardless of this value — see
# the comment on `server.environment.PORT` in docker-compose.yml for why
# those two are deliberately not the same variable.
# SERVER_PORT=4000
