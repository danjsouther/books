# Copy to .env for local development. See packages/config/src/env.ts for the
# validated shape — the process fails fast at boot if any of this is wrong.
#
# The Docker Compose surface (Phase 10) will grow this file rather than replace it.

NODE_ENV=development
PORT=4000

# The origin the browser loads the app from. In dev this is the Angular dev
# server, not the API — the proxy keeps both same-origin from the browser's side.
PUBLIC_BASE_URL=http://localhost:4200

DATABASE_URL=postgres://books:books@localhost:5432/books

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30

COOKIE_SECURE=true
# COOKIE_DOMAIN=

# From your Discord application's OAuth2 page. The redirect URI must match one
# registered there exactly, including the path — through the dev-server proxy
# that is the web app's own origin, not the API's.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4200/api/v1/auth/discord/callback

# The Discord guild (server) id that gates access. Members outside this guild
# authenticate successfully with Discord but are rejected at the callback.
DISCORD_ALLOWED_GUILD_ID=

# The bot's own token, from your Discord application's Bot page — separate
# from DISCORD_CLIENT_SECRET, which is for the web login flow.
DISCORD_BOT_TOKEN=
# Your Discord application's id (the "Application ID" on its General
# Information page, not the bot's user id).
DISCORD_APP_ID=
# Set for instant, guild-scoped slash-command registration during local dev.
# Leave unset for global registration (up to 1h to propagate).
# DISCORD_GUILD_ID=

# Where the bot sends a member to sign in, e.g. in the "you're not linked yet"
# reply. In dev this is the same origin as PUBLIC_BASE_URL, but they're kept
# as separate variables — see packages/config/src/env.ts.
WEB_BASE_URL=http://localhost:4200
