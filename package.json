{
  "name": "books",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --names web,api,bot --prefix-colors cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:bot\"",
    "dev:web": "ng serve",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/server/src/main.ts",
    "dev:bot": "tsx watch --env-file-if-exists=.env apps/bot/src/main.ts",
    "start": "node dist/server/main.js",
    "build": "npm run build:web && npm run build:server",
    "build:web": "ng build",
    "build:server": "node scripts/build-server.mjs",
    "build:bot": "node scripts/build-bot.mjs",
    "build:migrate": "node scripts/build-migrate.mjs",
    "bot:deploy-commands": "tsx --env-file-if-exists=.env apps/bot/src/deploy-commands.ts",
    "test": "npm run test:web && npm run test:node",
    "test:web": "ng test",
    "test:node": "vitest run --config vitest.node.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:seed": "tsx packages/db/src/cli/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/aria": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "angular-eslint": "22.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
